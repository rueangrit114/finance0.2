{
  "name": "finance-chat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vercel": "^47.0.4",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "@cloudflare/next-on-pages": {
      "next": "$next"
    },
    "wrangler": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  }
}
